{
    "name": "flashcard-app",
    "version": "1.0.0",
    "description": "This is a solution to the [Flashcard app challenge on Frontend Mentor](https://www.frontendmentor.io/challenges/flashcard-app). Frontend Mentor challenges help you improve your coding skills by building realistic projects.",
    "main": "server/index.js",
    "engines": {
        "node": ">=20.11.0"
    },
    "scripts": {
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "dev:server": "nodemon --env-file=.env",
        "dev:client": "vite",
        "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
        "build:client": "vite build",
        "build:server": "tsc -p tsconfig.json",
        "build": "npm run build:client && npm run build:server",
        "start": "node dist/server/index.js",
        "lint": "eslint",
        "lint:fix": "eslint . --fix",
        "lint:html": "htmlhint \"**/*.html\"",
        "lint:css": "stylelint \"**/*.css\"",
        "format": "prettier --write ."
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jezzydev/flashcard-app.git"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "module",
    "bugs": {
        "url": "https://github.com/jezzydev/flashcard-app/issues"
    },
    "homepage": "https://github.com/jezzydev/flashcard-app#readme",
    "dependencies": {
        "bcrypt": "^6.0.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "express": "^5.2.1",
        "express-rate-limit": "^8.4.1",
        "jsonwebtoken": "^9.0.3",
        "pg": "^8.20.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/bcrypt": "^6.0.0",
        "@types/cookie-parser": "^1.4.10",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^26.1.1",
        "@types/pg": "^8.20.0",
        "concurrently": "^9.2.1",
        "eslint": "^10.2.1",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.5.0",
        "htmlhint": "^1.9.2",
        "jsdom": "^29.1.1",
        "nodemon": "^3.1.14",
        "prettier": "^3.8.3",
        "stylelint": "^17.9.1",
        "stylelint-config-standard": "^40.0.0",
        "ts-node": "^10.9.2",
        "tsx": "^4.23.1",
        "typescript": "^7.0.2",
        "vite": "^8.0.10",
        "vitest": "^4.1.9"
    }
}
